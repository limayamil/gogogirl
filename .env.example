# Cadena de conexion de Neon (proyecto "gogogirl").
# Neon Console -> tu proyecto -> Connection string (pooled).
DATABASE_URL="postgresql://usuario:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Adjuntos: bucket S3-compatible (Neon Object Storage, Cloudflare R2, S3...).
# Ojo con los nombres: el prefijo AWS_* esta reservado en los entornos serverless,
# por eso las variables se llaman S3_* y no AWS_*.
# En produccion se cargan en Netlify: Site configuration -> Environment variables.
# Para Neon: Console -> Storage -> tu bucket -> credenciales y endpoint.
S3_ENDPOINT="https://br-xxxx.storage.c-2.region.aws.neon.tech"
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Panel interno en /interno. Si falta cualquiera de las dos, esa ruta no existe.
# El hash lo genera el helper de la app (no inventes uno):
# npx tsx -e "import { hashPassword } from './api/_lib/passwords.ts'; console.log(await hashPassword('elegi-una-contrasena'))"
# Comillas simples: el hash tiene $ y dotenv los expandiria entre comillas dobles.
GOGOGIRL_ADMIN_USERNAME=''
GOGOGIRL_ADMIN_PASSWORD_HASH=''

# Tablet e-ink "Gogogirl - to go!": GET /api/tablet/tasks y POST /api/tablet/tasks/done.
# El token va en el lector como "Authorization: Bearer <token>"; el usuario dice de que
# cuenta es la lista. Si falta cualquiera de las dos, esas rutas no existen (404).
# Generar el token: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TABLET_TOKEN=''
TABLET_USERNAME=''
