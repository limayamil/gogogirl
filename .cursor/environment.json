{
  "name": "GoGoGirl",
  "user": "ubuntu",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "neon-proxy",
      "command": "node .cursor/neon-proxy/server.mjs"
    },
    {
      "name": "dev",
      "command": "NODE_OPTIONS=\"--import=./.cursor/neon-local.mjs\" npm run dev"
    }
  ],
  "ports": [
    { "name": "web", "port": 5173 },
    { "name": "api", "port": 3001 }
  ]
}
